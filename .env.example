PORT=3000
NODE_ENV=production

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-mysql-database
DB_SSL=true
DB_CREATE_DATABASE=false
DB_AUTO_INIT=false

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-frontend-domain.example.com

# false disables 2FA globally; true allows opted-in employees to use it.
TWO_FACTOR_ENABLED=false
TWO_FACTOR_EMAIL_PROVIDER=gmail
TWO_FACTOR_SMS_PROVIDER=twilio
TWO_FACTOR_TEST_MODE=false

GMAIL_USER=company-mailbox@gmail.com
GMAIL_APP_PASSWORD=google-app-password

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
